# Copy to .env and fill in your own values. .env is gitignored.

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1            # Vertex AI region
REGION=us-central1              # Cloud Run region
GCS_BUCKET_NAME=your-bucket-with-hr-policies

# Jina AI — embeddings + reranker
JINA_API_KEY=

# Qdrant Cloud — vector store
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=hr_policies
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# Groq — LLM fallback and eval judge
GROQ_API_KEY=

# LangSmith — tracing and evaluation
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-policy-assistant

# Safety guardrail: model_armor | gemini_lite | none
GUARDRAIL_PROVIDER=model_armor
MODEL_ARMOR_LOCATION=us
MODEL_ARMOR_TEMPLATE_ID=your-template-id

# Comma-separated emails allowed past the Google login gate
ALLOWED_EMPLOYEE_EMAILS=you@example.com
